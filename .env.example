# Nusxa oling: cp .env.example .env

# Django: production'da DEBUG=false va uzun tasodifiy DJANGO_SECRET_KEY majburiy
# Kalit yaratish: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
# Qo'shimcha domenlar (vergul bilan). SITE_URL domeni avtomatik qo'shiladi
ALLOWED_HOSTS=

# Saytning ommaviy manzili (sitemap, ulashish havolalari, Telegram webhook)
SITE_URL=http://localhost:8000

# Administrator hisobi (migrate paytida yaratiladi)
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=ozgartiring-12345

# PostgreSQL (Neon, Supabase yoki o'z serveringiz). Bo'sh bo'lsa — lokal SQLite (./data/uysmeta.sqlite3)
DATABASE_URL=

# Ma'lumotlar papkasi (SQLite va yuklangan rasmlar). Bo'sh bo'lsa — ./data
DATA_DIR=

# Namuna ustalar va sharhlar. Haqiqiy saytda albatta false
SEED_DEMO_DATA=true

# Ichki hamyon (to'lov tizimisiz). Ro'yxatdan o'tganda beriladigan bonus, so'm
WALLET_SIGNUP_BONUS=300000
# false — bonusni kartaga yechib bo'lmaydi (faqat tariflarga sarflanadi). Haqiqiy saytda false tavsiya etiladi
WALLET_BONUS_WITHDRAWABLE=true
WALLET_MIN_WITHDRAW=10000

# Telegram bot — tasdiqlash kodlari va bildirishnomalar (bepul). @BotFather'da /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SMS (Eskiz.uz) — ixtiyoriy
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Kodlarni xeshlash uchun tasodifiy maxfiy satr (eski saytdagi qiymat bilan bir xil qoldiring)
OTP_SECRET=

# AI rasm tahlili — ixtiyoriy. Bepul: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Claude — "AI jihozlash" bo'limi uchun majburiy (https://console.anthropic.com):
ANTHROPIC_API_KEY=

# HTTPS (odatda reverse-proxy bajaradi). Faqat sayt to'liq https bo'lsa yoqing
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000

# "Real ko'rinish" (fotorealistik rasm) — BEPUL yo'l: Cloudflare Workers AI (FLUX.2), karta shart emas.
# 1) dash.cloudflare.com da bepul ro'yxatdan o'ting; Account ID — bosh sahifaning o'ng tomonida.
# 2) My Profile → API Tokens → Create Token → "Workers AI" shabloni → token.
# Sozlansa, real ko'rinish avval shu bilan chiziladi (Gemini rasm modeli faqat zaxira).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# "Real ko'rinish" — foydalanuvchi yuklagan xona rasmi loyiha bo'yicha jihozlanadi (static/js/room3d.js, bepul):
# Gemini tahlil modeli rasmdagi orqa devor burchaklari, deraza va eshiklarni topadi, 3D sahna shu perspektivada chiziladi.
# Qo'shimcha "AI fotorealistik variant" — Gemini rasm modeli (pullik). "AQ." bilan boshlanadigan Google Cloud kaliti
# Vertex AI orqali ishlaydi: Cloud loyihada Vertex AI API yoqilgan va billing ulangan bo'lishi shart.
# GEMINI_BACKEND=auto   (auto | vertex | studio)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE=false   (Gemini rasm modelini o'chirish)
