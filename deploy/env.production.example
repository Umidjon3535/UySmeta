# Haqiqiy server sozlamalari. deploy/setup.sh bu fayldan .env yaratadi va maxfiy kalitlarni o'zi to'ldiradi.
# Qo'lda to'ldiriladiganlar: DOMAIN, ADMIN_PHONE, ADMIN_PASSWORD, TELEGRAM_*, GEMINI/ANTHROPIC kalitlari.

# --- Domen (Caddy shu domen uchun HTTPS sertifikat oladi) ---
DOMAIN=uysmeta.duckdns.org
SITE_URL=https://uysmeta.duckdns.org

# --- Django: haqiqiy rejim (test emas) ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=__AUTO__
OTP_SECRET=__AUTO__
SECURE_HSTS_SECONDS=31536000

# --- Administrator (birinchi ishga tushishda yaratiladi). Parol kamida 8 belgi ---
ADMIN_PHONE=+998954825335
ADMIN_PASSWORD=

# --- Aloqa (footer, "Biz haqimizda") ---
CONTACT_PHONE=+998954825335
CONTACT_TELEGRAM=uysmetabot

# --- Baza: bo'sh — server diskidagi SQLite (docker volume'da saqlanadi) ---
DATABASE_URL=

# --- Namuna ustalar/do'konlar (faqat jadval bo'sh bo'lsa qo'shiladi) ---
SEED_DEMO_DATA=true

# --- Hamyon ---
WALLET_SIGNUP_BONUS=300000
WALLET_BONUS_WITHDRAWABLE=false
WALLET_MIN_WITHDRAW=10000

# --- Telegram bot: tasdiqlash kodlari, kirish, bildirishnomalar (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=uysmetabot

# --- SMS (Eskiz.uz) — ixtiyoriy ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- AI (ixtiyoriy): Gemini — bepul rasm tahlili; Claude — "Xonani jihozlash" ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
